# Тексты сообщений для Discord-канала.
# Плейсхолдеры: %player%, %server%, %from%, %to%, %message%, %command%, %count%
# Эмодзи и markdown поддерживаются.
#
# messages-version — НЕ менять. Должна совпадать с версией плагина.
# Если не совпадает, файл будет переименован в messages.old.<version>.yml и создан новый.
messages-version: "${version}"

proxy:
  start: "🟢 **Прокси запущен**"
  stop: "🔴 **Прокси выключается**"

player:
  join: "🟢 **%player%** зашёл на сервер `%server%`"
  leave: "🔴 **%player%** вышел"
  switch: "↔️ **%player%**: `%from%` → `%to%`"
  # %displayname% включает prefix/suffix из LuckPerms (если установлен), иначе — просто ник
  # %server% — имя бэкенд-сервера, %player% — чистый ник
  chat: "**%displayname%** [`%server%`]: %message%"
  command: "📝 `%player%` выполнил /%command%"

discord:
  # Формат сообщения из Discord в MC-чат (рендерится через MiniMessage).
  chat:
    # %role% — высшая роль Discord с цветом (MiniMessage). %player% — отображаемое имя
    mc: "[Discord | %role%] %player%: %message%"

command:
  list:
    header: "**Доступно команд прокси: %count%**"
    empty: "Команд не зарегистрировано"
    wrong-channel: "Эта команда доступна только в console-канале"
  profile:
    # Заголовок embed. Плейсхолдер: %player%
    title: "Время игрока %player%"
    # Подпись под заголовком. Плейсхолдеры: %period%
    period: "Период: %period%"
    period-all: "всё время"
    period-day: "за сегодня"
    period-week: "за 7 дней"
    period-month: "за 30 дней"
    period-year: "за год"
    period-custom: "с %from% по %to%"
    # Формат одной строки-сервера. Плейсхолдеры: %server%, %time%
    server-line: "`%server%` — %time%"
    # Строка «всего», добавляется последней. Плейсхолдер: %time%
    total-line: "**Всего: %time%**"
    # Когда игрок вообще не найден в БД
    unknown-player: "Игрок `%player%` не найден в статистике"
    # Когда Statify-интеграция выключена в config.yml
    disabled: "Команда /time выключена (см. `statify.enabled` в config.yml)"
    # Когда БД недоступна
    db-error: "Не удалось получить данные из БД: %error%"
    # Форматы времени. %d %h %m %s подставляются как числа.
    time:
      format-full: "%days%д %hours%ч %minutes%м"
      format-hm: "%hours%ч %minutes%м"
      format-m: "%minutes%м"
      zero: "нет"
  players:
    title: "Онлайн-игроки"
    # Плейсхолдер: %server%, %count%
    server-field: "%server% (%count%)"
    empty: "нет игроков"
    # Плейсхолдер: %count%
    total: "Всего онлайн: %count%"
    unknown-server: "Сервер `%server%` не найден"
